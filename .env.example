DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Gemini API keys. GEMINI_API_KEY is slot 1 / backward-compatible primary.
# Up to five keys may be configured, but the bot uses one selected slot at a time.
# Changing GEMINI_API_KEY_SLOT requires restarting the bot process.
# Quota/rate-limit errors do NOT automatically rotate to another key.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_SLOT=1

# Optional: absolute ffmpeg.exe path when SYSTEM PATH cannot find FFmpeg.
FFMPEG_PATH=
