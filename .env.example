DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Gemini API keys. GEMINI_API_KEY is slot 1 / backward-compatible primary.
# Configure up to five non-empty slots. TTS requests rotate round-robin across them:
# 1 -> 2 -> 3 -> 4 -> 5 -> 1. One TTS item keeps the same key through Gemini failover.
# GEMINI_API_KEY_SLOT chooses the starting slot; changing .env requires a process restart.
# Intended for multiple keys from the same project; project quota is still shared.
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_SLOT=1

# Optional: absolute ffmpeg.exe path when SYSTEM PATH cannot find FFmpeg.
FFMPEG_PATH=
